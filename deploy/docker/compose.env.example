# Rutas de los dos repos en ESTE server. Copiar a `compose.env` y ajustar:
#
#   cp deploy/docker/compose.env.example deploy/docker/compose.env
#   docker compose -f deploy/docker/docker-compose.yml --env-file deploy/docker/compose.env up -d
#
# `compose.env` está en .gitignore a propósito: las rutas del miniserver no son las del
# Fedora y versionar una concreta rompe el otro worktree.

CMF_REPO=/srv/cmf
FDC_REPO=/srv/fdc

# Perfil de rclone para el backup a Google Drive. Se monta CON ESCRITURA porque rclone
# reescribe rclone.conf cada vez que refresca el token de OAuth.
RCLONE_CONFIG_DIR=/root/.config/rclone

FDC_URL=https://www.findatachile.com
